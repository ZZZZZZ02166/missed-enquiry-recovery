# Copy to .env and fill in. Never commit .env — it holds live Twilio credentials.
# Claude is denied read access to .env files (.claude/settings.json).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development

# Matches docker-compose.yml
DATABASE_URL=postgresql://mer:mer_local_dev@localhost:5432/mer?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# PUBLIC_API_URL must be the exact URL Twilio calls. Signature validation rebuilds
# the signed string from it, so a mismatch (http vs https, wrong host behind a proxy)
# fails every webhook with no useful error. Locally this is the ngrok/cloudflared URL.
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000

# In production these must share a registrable domain (D9) — api.example.com and
# app.example.com — or the session cookie becomes cross-site and Safari blocks it.
SESSION_COOKIE_DOMAIN=localhost

# Minimum 32 characters — the app refuses to boot otherwise.
#   openssl rand -base64 32
SESSION_SECRET=replace-me-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Twilio  (see docs/twilio-setup.md)
# ---------------------------------------------------------------------------
# Auth token is required for webhook signature validation and cannot be replaced
# by an API key. API keys are used for outbound calls because they can be revoked
# individually.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Numbers in E.164
TWILIO_VOICE_NUMBER=
TWILIO_SMS_NUMBER=

# ---------------------------------------------------------------------------
# Cost circuit breakers  (queues-redis skill §9)
# ---------------------------------------------------------------------------
# Application-level caps. Twilio usage triggers are a separate backstop for the
# case where the application itself is what's broken.
MAX_SMS_PER_BUSINESS_PER_DAY=200
MAX_SMS_PER_NUMBER_PER_DAY=1
SENDING_ENABLED=true

# ---------------------------------------------------------------------------
# LLM  (extraction only — never pricing, CLAUDE.md rule 2)
# ---------------------------------------------------------------------------
# Customer message text leaves our infrastructure for this. Check the provider's
# retention and training terms and disclose it (docs/compliance.md §6).
#
# Which provider extracts fields: anthropic (default) or openai. Explicit rather
# than inferred from whichever key is set — with two providers that inference is
# ambiguous the moment both are present. Only the selected provider's key is
# required; without it the app runs the fake in development and refuses to boot in
# production, because a fake that extracts nothing looks exactly like customers
# who stopped replying.
#
# Leave LLM_PROVIDER unset to take the default. A blank value is a boot error, not
# a fall-back to the default.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Web (browser-exposed — NEXT_PUBLIC_* is shipped to the client)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
