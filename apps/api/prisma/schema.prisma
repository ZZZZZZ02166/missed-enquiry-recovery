// Schema grows table by table (CLAUDE.md build protocol), not all twelve at once.
// Landed so far: businesses, users, phone_numbers, webhook_events, customers, calls,
//                suppressions, messages, conversations, leads.
// Remaining: services, attachments.
//
// Conventions (.claude/skills/backend/SKILL.md §4):
//   camelCase fields, snake_case tables and columns via @map/@@map
//   cuid() ids — sequential integers leak volume and enable cross-tenant enumeration
//   createdAt / updatedAt on every table
//   money as integer cents, never Float
//
// AFTER EDITING THIS FILE, RUN BOTH:
//   pnpm prisma migrate dev --name <change>
//   pnpm prisma generate
// `migrate dev` does NOT regenerate the client for this generator + custom output
// path. Skip the second command and the new model is simply absent from the client:
// `db.phoneNumber` is undefined, which reads as a TypeScript problem rather than a
// stale-codegen one.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // CommonJS to match the API's tsconfig — Nest's DI needs emitDecoratorMetadata,
  // and mixing an ESM client into that toolchain is avoidable pain.
  moduleFormat        = "cjs"
  // Emit extensionless relative imports. Left unset, the generator emits ESM-style
  // "./internal/class.js" specifiers, which tsc resolves but Jest does not — the
  // whole tenant-guard suite fails to even load with "Cannot find module
  // './internal/class.js'". Pinning it here keeps codegen deterministic instead of
  // depending on which command happened to trigger generation.
  importFileExtension = ""
}

// Prisma 7 removed `url` from the datasource block. The connection string lives in
// prisma.config.ts for the CLI, and reaches the client via a driver adapter.
datasource db {
  provider = "postgresql"
}

/// A customer organisation. The tenant boundary — almost every other table
/// carries businessId, and the assertion extension enforces it (D8).
model Business {
  id   String  @id @default(cuid())
  name String
  abn  String?

  /// IANA zone. All scheduling derives from this, never server local time
  /// (CLAUDE.md rule 12) — otherwise DST breaks follow-ups twice a year.
  timezone String @default("Australia/Melbourne")

  /// How the owner entered their prices. Caller-facing figures are always
  /// GST-inclusive regardless (ACL single-price rule, docs/compliance.md §5).
  pricesIncludeGst Boolean @default(false)

  /// Opening hours per weekday. JSON while there is one shape; promote to a
  /// table if per-service or per-staff hours ever land.
  hours Json?

  /// Message templates, follow-up timing, after-hours behaviour. JSON rather
  /// than an automation_rules table until a second business needs something
  /// genuinely different (docs/decisions.md, Part 3 cuts).
  automationConfig Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  phoneNumbers  PhoneNumber[]
  customers     Customer[]
  calls         Call[]
  suppressions  Suppression[]
  messages      Message[]
  conversations Conversation[]
  leads         Lead[]

  @@map("businesses")
}

/// A person who logs into the dashboard. One role for the MVP — roles and
/// invitations are deferred, tenant scoping is not.
model User {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  email String  @unique
  name  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("users")
}

/// What a provisioned number is for. A business has one of each: the local voice
/// number their carrier forwards missed calls to, and the mobile number the
/// two-way recovery conversation runs on (docs/twilio-setup.md §4).
enum PhoneNumberPurpose {
  VOICE_INBOUND
  SMS_TWO_WAY

  @@map("phone_number_purpose")
}

/// SUSPENDED is the offboarding grace state, not a synonym for disabled. When a
/// business cancels, their carrier is still forwarding calls to us — cutting the
/// number dead sends *their customers* to a dead line. We keep answering with
/// "please call the main line" for 30 days (docs/compliance.md §8).
enum PhoneNumberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RELEASED

  @@map("phone_number_status")
}

/// A Twilio number we own on a business's behalf.
///
/// This is the table that resolves tenancy for every inbound webhook: Twilio gives
/// us `To`, and this maps it to a businessId. That lookup necessarily happens
/// *before* a tenant is known, so it is the primary legitimate caller of
/// `prisma.unscoped` (D8).
model PhoneNumber {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// Our Twilio number, E.164. Globally unique — this is a safety constraint, not a
  /// convenience one. Two businesses sharing an inbound number would route one
  /// business's callers to the other, which is the worst failure this system has.
  e164 String @unique

  /// Null until the number is actually provisioned — an AU regulatory bundle can
  /// take days, so a business record exists before its numbers do.
  twilioSid String? @unique @map("twilio_sid")

  purpose PhoneNumberPurpose
  status  PhoneNumberStatus  @default(PENDING)

  statusChangedAt DateTime? @map("status_changed_at")

  /// The number the business advertises and forwards *from* — their own mobile.
  /// Needed to write correct offboarding instructions, and to recognise the
  /// business's own staff calling in.
  forwardsFromE164 String? @map("forwards_from_e164")

  /// Underlying carrier, free text because MVNOs resell all three networks. Stored
  /// because D13 may restrict us to carriers that preserve the caller's number on a
  /// forwarded leg — in which case this becomes a support and eligibility field,
  /// not a curiosity.
  forwardingCarrier String? @map("forwarding_carrier")

  /// Set only when a real test call has arrived through this number end to end.
  /// Onboarding must not activate an account on the assumption that dialling the
  /// MMI codes worked; forwarding fails silently and often.
  forwardingVerifiedAt DateTime? @map("forwarding_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, purpose])
  @@map("phone_numbers")
}

/// Twilio Lookup line type, cached so we never pay for the same number twice
/// (~US$0.008 per lookup). UNKNOWN means not yet looked up — distinct from a lookup
/// that ran and returned something unusable.
enum LineType {
  UNKNOWN
  MOBILE
  LANDLINE
  VOIP
  TOLL_FREE
  OTHER

  @@map("line_type")
}

/// A person who has called a business. Created on first contact, then reused —
/// this is what makes "they've rung us before" possible.
model Customer {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// E.164, normalised at the edge (CLAUDE.md rule 6). The unique constraint below
  /// only means anything because every writer normalises first.
  phoneE164 String @map("phone_e164")

  /// Learned from the SMS conversation, not from the call. Null until they say.
  name  String?
  email String?

  /// Cached Twilio Lookup result. Texting a landline fails and we are billed anyway,
  /// so this is checked before the first send and never looked up twice.
  lineType   LineType  @default(UNKNOWN)
  lineTypeAt DateTime? @map("line_type_at")

  /// Staff, suppliers, existing customers mid-job. They get a different message —
  /// "What service do you need?" is jarring when you are ringing about today's job.
  isKnownContact Boolean @default(false) @map("is_known_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  calls         Call[]
  messages      Message[]
  conversations Conversation[]
  leads         Lead[]

  /// The same phone number is a different customer for a different business.
  @@unique([businessId, phoneE164])
  @@index([businessId, createdAt])
  @@map("customers")
}

/// How the call ended, from Twilio's `CallStatus`.
///
/// NO_ANSWER / BUSY / FAILED are what a *forwarded* call looks like when the owner
/// did not pick up — they are the product's trigger, not errors.
enum CallOutcome {
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED

  @@map("call_outcome")
}

/// Why no recovery SMS was sent. Null means one was (or is about to be).
///
/// Every one of these is a real, frequent case that costs money or trust if handled
/// wrong, and the reason has to survive so "why did this caller never hear from us?"
/// is answerable months later.
enum NoRecoveryReason {
  /// Caller ID withheld — nobody to text.
  ANONYMOUS_CALLER
  /// Twilio Lookup says landline or toll-free; an SMS would fail and still bill us.
  NOT_TEXTABLE
  /// STOP, or a blocklist entry.
  SUPPRESSED
  /// Already texted this number for this business within the throttle window.
  RECENTLY_CONTACTED
  /// Staff, supplier, or an existing customer mid-job.
  KNOWN_CONTACT
  /// Per-business daily cap or the global kill switch.
  CAP_REACHED
  /// The owner answered. Nothing to recover.
  ANSWERED
  /// Queued but never sent, and now too old to be worth sending — a queue outage that
  /// outlasted the window. Deliberately terminal rather than retried forever: a
  /// recovery text a day late is worse than none, because the caller booked someone
  /// else hours ago and an unexplained text from an unknown number reads as spam.
  EXPIRED

  @@map("no_recovery_reason")
}

/// A single inbound call.
///
/// A call is NOT a lead (D5). Leads are created lazily on the customer's first
/// reply; calls that never get a response stay here. That is what keeps the owner's
/// inbox honest and makes "% of missed callers who became qualified leads"
/// computable.
///
/// No recording, ever — metadata only (CLAUDE.md rule 3).
model Call {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// Null for a withheld caller ID: the call still happened and is still recorded,
  /// there is simply no one to attribute it to.
  customerId String? @map("customer_id")

  /// Twilio's CallSid. Unique — one row per call, however many webhooks it emits.
  providerCallSid String @unique @map("provider_call_sid")

  /// The caller, E.164. Null when withheld.
  fromE164 String? @map("from_e164")
  /// Our Twilio number they reached.
  toE164   String  @map("to_e164")

  /// The business's own number, when the carrier supplies a diversion header.
  /// Inconsistently populated on AU PSTN, so never depended on — stored because it
  /// is evidence for the D13 question of what carriers actually pass through.
  forwardedFromE164 String? @map("forwarded_from_e164")

  outcome CallOutcome @default(IN_PROGRESS)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// Whole seconds, from Twilio. Our leg only — the greeting, not the ring time.
  durationSeconds Int? @map("duration_seconds")

  /// Set when the recovery SMS is enqueued, not when it is delivered. The message's
  /// own delivery status lives on `messages`.
  recoverySmsQueuedAt DateTime? @map("recovery_sms_queued_at")

  /// Null when a recovery SMS was sent. Otherwise the reason it was not — the
  /// denominator of the pilot's headline metric depends on being able to separate
  /// "we chose not to text" from "we failed to text".
  noRecoveryReason NoRecoveryReason? @map("no_recovery_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages     Message[]
  conversation Conversation?

  /// The dashboard's default view: this business's calls, newest first.
  @@index([businessId, startedAt])
  /// "Which missed calls never got a recovery text, and why?"
  @@index([businessId, noRecoveryReason])
  /// The reconciler's query: calls whose recovery was queued but never sent. Ordered
  /// by the marker itself so the sweep is a bounded range scan over a window rather
  /// than a scan of every call ever recorded. Cross-tenant by necessity — the sweep
  /// is not on behalf of one business.
  @@index([recoverySmsQueuedAt])
  @@index([customerId])
  @@map("calls")
}

/// Why a number must not be texted — the *operational* reason.
///
/// One table covers three concerns that all answer the same question at the same
/// moment — "may we send to this number?" — and splitting them would mean three
/// lookups on the hot path and three chances to forget one.
///
/// OPTED_OUT is deliberately NOT a member. A customer replying STOP is a legal fact
/// that can coexist with an operational one, and collapsing the two into a single
/// column destroyed information: a blocked marketer who texted STOP then START had
/// their block deleted along with the opt-out (found at step 31). The opt-out now
/// lives in `optedOutAt`, orthogonal to this enum.
enum SuppressionReason {
  /// Twilio Lookup says landline or toll-free; a send fails and still bills us.
  NOT_TEXTABLE
  /// Owner blocked them from the dashboard — a marketer, a nuisance caller.
  SPAM
  /// Staff, supplier, or an existing customer mid-job. Seeded at onboarding.
  STAFF

  @@map("suppression_reason")
}

/// Numbers we must not send to.
///
/// OPTED_OUT rows are the reason this table is checked before every send and never
/// bulk-deleted: honouring an opt-out means keeping the record of it, which makes
/// this a deliberate exception to data minimisation (docs/compliance.md §7).
///
/// Twilio maintains its own opt-out list per sending number and rejects sends with
/// error 21610 even when our database thinks a number is fine. That is why the
/// worker must back-fill a row on 21610: the two lists diverge, and Twilio's is
/// authoritative for what actually gets delivered.
model Suppression {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// E.164, normalised at the edge. The unique constraint below is only meaningful
  /// because every writer normalises first (CLAUDE.md rule 6).
  phoneE164 String @map("phone_e164")

  /// The operational reason, or null when the row exists purely because of an
  /// opt-out. At least one of `reason` and `optedOutAt` is always set — a row with
  /// neither would suppress a number for no recorded cause.
  reason SuppressionReason?

  /// When the customer replied STOP. The legal fact, kept independent of `reason`
  /// so that clearing one cannot silently clear the other.
  ///
  /// Set → the number is suppressed regardless of `reason`, and `isSuppressed`
  /// reports OPTED_OUT. START clears this timestamp and nothing else, so an owner's
  /// block underneath survives.
  optedOutAt DateTime? @map("opted_out_at")

  /// Free text for the dashboard — "blocked by owner, repeated marketing calls".
  note String?

  /// The inbound message carrying the STOP, when there was one. Evidence that the
  /// opt-out was honoured, and when. Not a foreign key: `messages` does not exist
  /// yet, and this must survive the 90-day retention sweep that will eventually
  /// remove the message itself.
  sourceMessageSid String? @map("source_message_sid")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// One row per number per business. A number opted out of one business's messages
  /// has said nothing about another's — suppression is per sender, as the Spam Act
  /// treats it.
  ///
  /// A row can now hold both an operational reason and an opt-out at the same time,
  /// so the single-row model no longer costs information.
  @@unique([businessId, phoneE164])
  /// Dashboard: "show me everything blocked as SPAM for this business".
  @@index([businessId, reason])
  /// Compliance: "show me every opt-out, newest first".
  @@index([businessId, optedOutAt])
  @@map("suppressions")
}

/// Where a qualification conversation has got to.
///
/// Deliberately small. The plan's original lifecycle mixed *states* with *flags* —
/// NEEDS_HUMAN can be true at any point, so modelling it as a state guarantees
/// impossible combinations and lost transitions (docs/decisions.md, Part 3).
enum ConversationState {
  /// The recovery SMS went out; nobody has replied yet.
  AWAITING_FIRST_REPLY
  /// They replied. We are asking for whatever is still missing.
  COLLECTING
  /// Everything required is answered. The lead is ready for the owner.
  COMPLETE
  /// No reply within the window. Terminal, but reopens if they text later.
  EXPIRED
  /// They asked us to stop. Terminal and never reopened.
  OPTED_OUT

  @@map("conversation_state")
}

/// One qualification thread with one customer.
///
/// The state machine's cursor, not the transcript — messages live in `messages` and
/// are joined by customer. Keeping them apart means a conversation can be replayed,
/// reset or expired without touching the billing record.
///
/// A conversation is created when the recovery SMS is sent, not when the call
/// arrives: a call nobody answered has nothing to converse about (D5).
model Conversation {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  customerId String @map("customer_id")

  /// The call this began from. Null once conversations can start from a web form.
  callId String? @unique @map("call_id")

  state ConversationState @default(AWAITING_FIRST_REPLY)

  /// Answers collected so far, keyed by field. JSON rather than columns because the
  /// question set is owner-configurable — a business asking about carpet cleaning and
  /// one asking about lawn size do not share a schema. The subset that the future
  /// pricing matrix needs is promoted onto `leads` as typed columns.
  collected Json @default("{}")

  /// The field currently being asked about. Null when nothing is outstanding.
  /// Stored rather than derived so an out-of-order reply can still be attributed to
  /// the question it answers.
  awaitingField String? @map("awaiting_field")

  /// How many questions we have asked. The hard stop against an infinite loop: a
  /// model that keeps failing to extract must not keep texting.
  questionsAsked Int @default(0) @map("questions_asked")

  /// Set when the state machine cannot proceed — an ambiguous reply, an unmatched
  /// service, an angry customer. A flag, not a state: it can be true at any point
  /// and does not interrupt the transition it accompanies.
  needsHuman       Boolean @default(false) @map("needs_human")
  needsHumanReason String? @map("needs_human_reason")

  /// Last inbound activity. Drives the nudge and the expiry sweep, and must be
  /// compared in the business's timezone, never the server's (CLAUDE.md rule 12).
  lastInboundAt DateTime? @map("last_inbound_at")
  /// Set when the single nudge has been sent, so a second one cannot be.
  nudgedAt      DateTime? @map("nudged_at")
  completedAt   DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  call     Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  /// Created lazily, on the customer's first reply. Null until then.
  lead     Lead?

  /// One open conversation per customer per business. A second missed call from
  /// someone mid-conversation must continue the existing thread, not start a rival
  /// one that asks the same questions again.
  @@unique([businessId, customerId, state])
  /// The worker's view: conversations due a nudge or expiry.
  @@index([state, lastInboundAt])
  /// The dashboard's view.
  @@index([businessId, updatedAt])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

/// Twilio's delivery lifecycle.
///
/// QUEUED → SENT → DELIVERED is the happy path. UNDELIVERED and FAILED are terminal
/// and mean the customer received nothing — which matters more than it sounds: a
/// "sent" recovery SMS that never arrived is a lost lead the dashboard would
/// otherwise show as contacted.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  /// Inbound messages have no delivery lifecycle — they already arrived.
  RECEIVED

  @@map("message_status")
}

/// Why an outbound message was sent. Inbound messages have no purpose.
/// Whether an *inbound* reply has been handed to, and completed by, the conversation
/// worker. Distinct from `MessageStatus`, which is about SMS delivery — the two answer
/// different questions and conflating them would hide exactly the failure this exists
/// to catch:
///
///   MessageStatus     did the SMS arrive?
///   processingStatus  did we act on it?
///
/// Null on outbound messages: they have no processing lifecycle, and defaulting them to
/// PENDING would fill the reconciler's queue with rows that are not work.
enum MessageProcessingStatus {
  /// Saved in Postgres, not yet accepted by Redis. **The durable outbox marker** — a
  /// row sitting here is work nobody is doing, and the reconciler's only target.
  PENDING
  /// BullMQ confirmed the job was added.
  QUEUED
  /// The worker finished, including the deliberate no-ops (an already-superseded
  /// reply, a permanent send failure that was recorded).
  PROCESSED
  /// Deliberately never processed, and terminal: a STOP, or a customer suppressed by
  /// the time the worker reached them. Distinct from PROCESSED so "we chose not to"
  /// is never confused with "we did", and distinct from PENDING so it does not look
  /// stuck.
  SKIPPED
  /// Permanently unprocessable — wrong direction, no customer, or retries exhausted.
  /// Exists so these rows stop being re-driven every minute and become queryable for
  /// triage instead.
  FAILED

  @@map("message_processing_status")
}

enum MessagePurpose {
  /// The first message after a missed call.
  RECOVERY
  /// A question in the qualification conversation.
  QUALIFICATION
  /// One nudge after silence.
  NUDGE
  /// Handoff — the business has what it needs.
  HANDOFF
  /// Staff replying by hand from the dashboard.
  MANUAL
  /// The structured lead SMS to the owner.
  OWNER_NOTIFICATION

  @@map("message_purpose")
}

/// Every SMS, in and out.
///
/// This is the billing record as well as the conversation transcript. `segments` and
/// `costCents` are stored per message because Twilio charges per segment, and margin
/// per customer is derived from summing this table — there is no other source for it
/// (`.claude/skills/queues-redis/SKILL.md` §9).
///
/// Retention: message bodies contain personal information and follow the 24-month
/// rule, not the 90-day one that applies to `webhook_events` (docs/compliance.md §7).
model Message {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// Null for a message to someone who never became a customer — an owner
  /// notification, or a send to a number we could not attribute.
  customerId String? @map("customer_id")

  /// The call that triggered this message, for outbound recovery. Null for inbound
  /// replies and owner notifications.
  callId String? @map("call_id")

  direction MessageDirection
  status    MessageStatus
  /// Null for inbound.
  purpose   MessagePurpose?

  /// Inbound only — see `MessageProcessingStatus`. Null on outbound.
  processingStatus MessageProcessingStatus? @map("processing_status")
  /// When it reached a terminal processing state, and why if it was not success.
  processedAt      DateTime?                @map("processed_at")
  processingNote   String?                  @map("processing_note")

  fromE164 String @map("from_e164")
  toE164   String @map("to_e164")

  /// The exact text sent or received. Not a template id — a template can change, and
  /// what a customer was actually told must not change with it.
  body String

  /// Twilio's MessageSid. Unique, and the join key for status callbacks.
  ///
  /// Nullable because the row is written *before* the provider call in some paths;
  /// a send that fails outright never gets one, and that row is still the record of
  /// the attempt.
  providerMessageSid String? @unique @map("provider_message_sid")

  /// Our own segment count, computed identically for every message whether it sent
  /// or not (CLAUDE.md rule 5). Twilio reports its own, inconsistently.
  segments Int @default(1)

  /// Integer cents, AUD (CLAUDE.md rule 11). Twilio prices in USD, so this is the
  /// converted figure at the time of sending — a rate that moves later must not
  /// silently rewrite historical margin.
  costCents Int? @map("cost_cents")

  /// Twilio error code when delivery failed. 21610 means they had opted out at
  /// Twilio's layer even though our suppression table said otherwise.
  errorCode    Int?    @map("error_code")
  errorMessage String? @map("error_message")

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  call     Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  /// The conversation thread, newest last.
  @@index([businessId, customerId, createdAt])
  /// Billing and margin: sum segments and cost over a period.
  @@index([businessId, createdAt])
  /// "Which sends failed?" — the operational view.
  @@index([businessId, status])
  /// The reconciler's only query: inbound replies stuck PENDING, oldest first. Leads
  /// with `processingStatus` so an equality match on it seeks straight to the (usually
  /// empty) PENDING range instead of scanning a table that grows with every message
  /// ever sent. Cross-tenant by necessity — the sweep is not on behalf of one business.
  @@index([processingStatus, createdAt])
  @@map("messages")
}

/// Where a lead is in the owner's pipeline.
///
/// Six statuses, and deliberately not eight. `NEEDS_HUMAN`, `SPAM`, `DUPLICATE` and
/// `OPTED_OUT` are **flags**, not statuses: each can be true at any point in the
/// pipeline, and modelling them as statuses guarantees state bugs the first time a
/// qualified lead turns out to be spam. `CONTACTED` is also absent — contact is
/// automatic and instant here, so it would be true of every lead the moment it exists
/// (Part 3 of the plan).
enum LeadStatus {
  /// Created on the customer's first reply, before anything is known.
  NEW
  /// Questions are still outstanding.
  QUALIFYING
  /// Everything required is answered. This is the one the owner acts on.
  QUALIFIED
  /// A price was computed and shown. Only reachable once services exist.
  QUOTED
  WON
  LOST

  @@map("lead_status")
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  UNIT
  OTHER

  @@map("property_type")
}

enum LeadUrgency {
  LOW
  NORMAL
  HIGH

  @@map("lead_urgency")
}

/// How a quoted figure should be read — and worded to the customer.
///
/// Mirrors the four pricing types on `services`, because the wording obligation
/// differs per type: a `FROM` price must say "starting from" and an `ESTIMATE` must
/// say the business will confirm (docs/decisions.md, Part 6).
enum QuoteType {
  /// A firm price the business will honour.
  FIXED
  /// Computed but not binding — per-unit totals, for instance.
  ESTIMATE
  /// A floor, not a price. "Prices start from ..."
  FROM
  /// No figure was shown. The default, and the only value possible today.
  NONE

  @@map("quote_type")
}

/// A missed caller who replied, with whatever they told us.
///
/// **A call is not a lead** (docs/decisions.md). Leads are created lazily, on the
/// customer's *first reply* — calls that never get a response stay as calls. That is
/// what keeps the owner's inbox honest, keeps spam out of it, and makes "% of missed
/// callers who become qualified leads" a number that means something.
///
/// One lead per conversation, enforced by a unique `conversationId`. The conversation
/// is the transcript and the cursor; the lead is the structured result the owner acts
/// on. Splitting them means the owner's view does not change shape every time the
/// question flow does.
model Lead {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  customerId String @map("customer_id")

  /// The thread this was extracted from. Unique: a conversation yields one lead.
  conversationId String @unique @map("conversation_id")

  status LeadStatus @default(NEW)

  /// Flags, not statuses. Each can be true alongside any status.
  needsHuman  Boolean @default(false) @map("needs_human")
  isSpam      Boolean @default(false) @map("is_spam")
  isDuplicate Boolean @default(false) @map("is_duplicate")
  optedOut    Boolean @default(false) @map("opted_out")

  /// Why a human is needed, or why the lead was lost. Shown to the owner, never
  /// to the customer.
  needsHumanReason String? @map("needs_human_reason")
  lostReason       String? @map("lost_reason")

  // --- Answers -------------------------------------------------------------
  //
  // Typed columns, not JSON, for the fields the future pricing matrix reads. The
  // matrix has to price in SQL/TS off beds, baths, carpet and suburb — and the
  // dashboard's "leads by suburb" is a GROUP BY rather than JSON surgery. The long
  // tail stays in `answers`.

  /// What the customer called it, in their words. Always populated.
  serviceType String? @map("service_type")

  /// The matched catalogue entry. Null until the `services` table exists — at which
  /// point this becomes a relation. Kept as a plain column now so the matching step
  /// is an additive migration rather than a reshape.
  serviceId String? @map("service_id")

  suburb        String?
  propertyType  PropertyType? @map("property_type")
  bedrooms      Int?
  bathrooms     Int?
  carpetedRooms Int?          @map("carpeted_rooms")

  /// The customer's own words ("next Tuesday"), deliberately unparsed. Converting it
  /// needs the business timezone and a reference point (rule 12), and getting it
  /// wrong silently books the wrong week.
  preferredDate String? @map("preferred_date")

  urgency          LeadUrgency?
  propertyCondition String?     @map("property_condition")

  /// Owner-configurable add-ons — oven, windows, balcony. Shape varies per business.
  extras Json?

  /// Everything the question flow collected, including fields with no column yet.
  /// The columns above are a promoted subset, not a replacement.
  answers Json @default("{}")

  /// Required fields still unanswered when the conversation ended. The owner's
  /// "what do I still need to ask?" list.
  missingFields String[] @map("missing_fields")

  // --- Quote ---------------------------------------------------------------
  //
  // Every figure here comes from PriceCalculator over the owner's stored config
  // (CLAUDE.md rule 2). Nothing writes these yet — services do not exist.

  /// Integer cents, AUD, GST-inclusive as shown to the caller (rule 11).
  quotedAmountCents    Int?      @map("quoted_amount_cents")
  quoteType            QuoteType @default(NONE) @map("quote_type")
  /// Whether the customer was actually told. A computed price the owner suppressed
  /// is still worth recording, and the two must not be conflated.
  quoteShownToCustomer Boolean   @default(false) @map("quote_shown_to_customer")
  quotedAt             DateTime? @map("quoted_at")

  /// The service config exactly as it stood when the quote was made. When the owner
  /// raises prices next month, what the customer was told must not change with them.
  quoteSnapshot Json? @map("quote_snapshot")

  // --- Outcome -------------------------------------------------------------

  /// Set when the structured lead SMS reaches the owner. The notify job's idempotency
  /// key: an owner must not be texted the same lead twice.
  ownerNotifiedAt DateTime? @map("owner_notified_at")

  /// What the job was worth. Owner-entered, and the input to the only commercial
  /// metric that matters — which is exactly why the ask has to be one tap
  /// ("reply 1W 450"), not a CRM form nobody fills in.
  wonValueCents Int?      @map("won_value_cents")
  closedAt      DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The owner's inbox: open leads, newest first.
  @@index([businessId, status, createdAt])
  /// The dashboard's default view and the weekly close-out sweep.
  @@index([businessId, createdAt])
  /// "Leads by suburb" without a table scan (plan §11).
  @@index([businessId, suburb])
  @@map("leads")
}

enum WebhookProvider {
  TWILIO
  STRIPE

  @@map("webhook_provider")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  /// Recognised, deliberately not acted on — a spam caller, a suppressed number,
  /// a status transition we don't care about. Distinct from FAILED so that a rising
  /// failure count means something is broken.
  IGNORED
  FAILED

  @@map("webhook_event_status")
}

/// Raw provider deliveries. The idempotency backbone: Twilio retries on any
/// non-timely 200, and duplicate delivery is documented behaviour rather than an
/// edge case. Replaying a payload three times must produce one call, one SMS,
/// one lead.
///
/// NOT a tenant model, deliberately — see the note on businessId below.
model WebhookEvent {
  id String @id @default(cuid())

  provider WebhookProvider

  /// The identity of *this delivery*, constructed by the handler rather than taken
  /// from a single provider field. A CallSid is not unique per delivery: one call
  /// produces an incoming webhook plus several status callbacks, all sharing it.
  /// Each handler therefore builds its own key and owns what "the same event" means:
  ///
  ///   twilio:voice:incoming:CAxxxx
  ///   twilio:voice:status:CAxxxx:completed
  ///   twilio:message:incoming:SMxxxx
  ///   twilio:message:status:SMxxxx:delivered
  ///
  /// A compound unique on (provider, externalEventId) would collide across the
  /// status callbacks of a single call and silently drop all but the first.
  dedupeKey String @unique @map("dedupe_key")

  /// CallSid / MessageSid. Not unique — kept so that everything about one call can
  /// be pulled up in one query when supporting a business.
  externalEventId String @map("external_event_id")

  /// e.g. voice.incoming, voice.status, message.incoming, message.status
  eventType String @map("event_type")

  /// Resolved from the `To` number after the fact, and null when it could not be —
  /// an unrecognised number, or a signature that failed before any lookup.
  ///
  /// This nullability is why WebhookEvent is absent from TENANT_MODELS: the row is
  /// written *before* the tenant is known, and is looked up by dedupeKey with no
  /// businessId in hand. It is an internal forensics table and is never exposed
  /// through the API. If that ever changes, it must be added to TENANT_MODELS and
  /// this column made required.
  businessId String? @map("business_id")

  /// Verbatim provider parameters, for replay and for reconstructing what happened.
  /// Contains caller phone numbers and message text — personal information, and the
  /// reason this table has the shortest retention of anything we store: 90 days
  /// (docs/compliance.md §7). It has no value beyond idempotency after that.
  payload Json

  /// False rows are kept on purpose. A burst of failed signatures is either a
  /// misconfigured PUBLIC_API_URL or someone probing the endpoint, and both are
  /// invisible if rejected requests leave no trace.
  signatureValid Boolean @map("signature_valid")

  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  processedAt DateTime?          @map("processed_at")

  /// Last failure, for triage. Not a stack trace — a short reason.
  error String?

  receivedAt DateTime @default(now()) @map("received_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  /// Support: "show me everything about this call".
  @@index([externalEventId])
  /// Ops: unprocessed or failed work, oldest first.
  @@index([status, receivedAt])
  /// Retention sweep.
  @@index([receivedAt])
  @@map("webhook_events")
}
