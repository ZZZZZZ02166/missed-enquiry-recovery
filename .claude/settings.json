{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm prisma generate:*)",
      "Bash(pnpm prisma migrate dev:*)",
      "Bash(pnpm prisma migrate deploy:*)",
      "Bash(pnpm prisma migrate status:*)",
      "Bash(pnpm prisma validate:*)",
      "Bash(pnpm prisma format:*)",
      "Bash(pnpm prisma studio:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose restart:*)",
      "Bash(redis-cli CONFIG GET:*)",
      "Bash(redis-cli INFO:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Bash(pnpm prisma db push:*)",
      "Bash(npx prisma db push:*)",
      "Bash(pnpm prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(docker compose down -v:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
